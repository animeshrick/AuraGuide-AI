# Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Stable model. If it reports high demand, try gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.6-flash
# Used in order when the model above keeps returning "high demand" errors.
GEMINI_MODEL_2=gemini-2.5-flash
GEMINI_MODEL_3=gemini-3.5-flash-lite

# Optional rate limiter threshold per client IP (default: 30)
RATE_LIMIT_PER_MINUTE=30
