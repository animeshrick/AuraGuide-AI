{
  "name": "auraguide-ai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Personal smog-day plans for households, from live air quality and Gemini.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
